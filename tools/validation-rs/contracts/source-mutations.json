    "suite": "ring",
    "name": "commit before reads",
    "test": "instrument::ring::tests::impulse_before_commit",
    "marker": "panicked at rust/dsp/src/instrument/ring/tests.rs:",
    "edits": [
      {
        "file": "rust/dsp/src/instrument/ring/tests.rs",
        "before": "fn impulse_before_commit() {\n    let mut ring = prepared(48000.0, Arm::Bridge);\n    let c = ring.samples.len();\n    // Flush the launch seed through ordinary commits, then inject at n=0.\n    for _ in 0..c {\n        push(&mut ring, 0.0);\n    }\n    for n in 0..4 * c {\n        for (delay, m, u) in [\n            (1.0, 1, 0.0),\n            (3.25, 3, 0.25),\n            ((c - 2) as f64, c - 2, 0.0),\n            (c as f64 - 0.25, c - 1, 0.75),\n            (c as f64, c, 0.0),\n        ] {\n            let expected = if n == m {\n                1.0 - u\n            } else if n == m + 1 {\n                u\n            } else {\n                0.0\n            };\n            assert_eq!(ring.read(delay), Ok(expected), \"tick {n}, tap {delay}\");\n        }\n        push(&mut ring, f64::from(n == 0));\n    }\n}\n\n#[test]\n",
        "after": "fn impulse_before_commit() {\n    let mut ring = prepared(48000.0, Arm::Bridge);\n    let c = ring.samples.len();\n    // Flush the launch seed through ordinary commits, then inject at n=0.\n    for _ in 0..c {\n        push(&mut ring, 0.0);\n    }\n    for n in 0..4 * c {\n        push(&mut ring, f64::from(n == 0));\n        for (delay, m, u) in [\n            (1.0, 1, 0.0),\n            (3.25, 3, 0.25),\n            ((c - 2) as f64, c - 2, 0.0),\n            (c as f64 - 0.25, c - 1, 0.75),\n            (c as f64, c, 0.0),\n        ] {\n            let expected = if n == m {\n                1.0 - u\n            } else if n == m + 1 {\n                u\n            } else {\n                0.0\n            };\n            assert_eq!(ring.read(delay), Ok(expected), \"tick {n}, tap {delay}\");\n        }\n\n    }\n}\n\n#[test]\n"
      }
    ]
  },
