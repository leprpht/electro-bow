#!/usr/bin/env sh
set -eu

if ! command -v clang-format >/dev/null 2>&1; then
    for llvm_bin in /opt/homebrew/opt/llvm/bin /usr/local/opt/llvm/bin; do
        if [ -x "$llvm_bin/clang-format" ]; then
            PATH="$llvm_bin:$PATH"
            export PATH
            break
        fi
    done
fi

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format is required but was not found in PATH." >&2
    echo "See README.md for installation instructions." >&2
    exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- \
    '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hh' '*.hpp' '*.hxx' || true)

for file in $files; do
    case "$file" in
        ThirdParty/*) continue ;;
    esac

    clang-format -i "$file"
    git add -- "$file"
done

ui_files=$(git diff --cached --name-only --diff-filter=ACMR -- \
    'UI/*.css' 'UI/*.html' 'UI/*.json' 'UI/*.ts' 'UI/*.tsx' \
    'UI/src/*.css' 'UI/src/*.html' 'UI/src/*.json' 'UI/src/*.ts' 'UI/src/*.tsx' || true)

if [ -n "$ui_files" ]; then
    prettier="UI/node_modules/.bin/prettier"
    if [ ! -x "$prettier" ]; then
        echo "pre-commit: Prettier is required for staged UI files but was not found." >&2
        echo "Run 'npm ci' in UI/ first." >&2
        exit 1
    fi

    for file in $ui_files; do
        "$prettier" --write "$file"
        git add -- "$file"
    done
fi
